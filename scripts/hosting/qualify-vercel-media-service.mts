 return {journal,snapshot:()=>({createsReserved:count,maximumCreates:3,unresolvedIntent:active,terminalSessions:[...sessions].map(([sessionId,status])=>({sessionId,status}))})};
}
async function immutableJson(path:string,sha256:string,max=1024*1024){await assertRemoteArchiveImmutableFile(path);if((await lstat(path)).size>max)throw Error('QUALIFICATION_CONFIGURATION_INVALID');const bytes=await readFile(path);if(hash(bytes)!==sha256)throw Error('QUALIFICATION_CONFIGURATION_INVALID');return JSON.parse(bytes.toString('utf8'));}
export async function runMediaServiceQualification(args:readonly string[]){

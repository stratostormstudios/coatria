type Config=ReturnType<typeof parseMediaServiceQualification>;
/** Root must reserve all three global ordinals before creating the trusted CPU
 * host. This journal cannot invent global authority or safely replay a host. */
export function mediaQualificationJournal(config:Config,append:(value:unknown)=>Promise<void>,signal:AbortSignal){

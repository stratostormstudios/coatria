# Server only. Never prefix credentials with NEXT_PUBLIC_.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/coatria?sslmode=require
# Canonical deployment origin; Vercel preview origins are also recognized.
APP_URL=http://localhost:4180
# Use 1 for the development-only PGlite emulator; production PostgreSQL defaults to 5.
# DATABASE_POOL_MAX=5
# Optional override, used only behind a trusted proxy.
# TRUST_PROXY=true

# Bounded read-only status reconciliation; never repeats a generation dispatch.
# Enable after applying migration028 and runtime permissions. Uses CRON_SECRET.
# HIGGSFIELD_JOB_RECONCILER_ENABLED=1

# Archive control plane. Leave false until the separate worker, decoder isolation,
# exact media-host policy, Runpod byte transfers and dedicated DB role are verified.
# COATRIA_HIGGSFIELD_ARCHIVE_ENABLED=false
# Worker-only; never put these in browser/public variables.
# COATRIA_ARCHIVE_SCRATCH_ROOT=/var/lib/coatria-archive/scratch
# COATRIA_HIGGSFIELD_OUTPUT_HOSTS=reviewed-provider-host.example
# COATRIA_FFPROBE_PATH=/opt/coatria/media-sandbox/ffprobe
# COATRIA_FFMPEG_PATH=/opt/coatria/media-sandbox/ffmpeg
# COATRIA_ARCHIVE_MAX_SOURCE_BYTES=536870912
# COATRIA_ARCHIVE_OPERATION_MS=1800000

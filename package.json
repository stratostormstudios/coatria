{
  "name": "coatria",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 4180",
    "prebuild": "node --import tsx scripts/check-avatar-assets.ts",
    "build": "next build",
    "start": "next start --port 4180",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "tsx --test tests/backend-integration.test.ts tests/calls.test.ts",
    "test:media": "node --import tsx tests/room-call-browser.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:migrate:local": "node --env-file=.env.local --import tsx scripts/migrate.ts"
  },
  "dependencies": {
    "lucide-react": "1.43.0",
    "next": "16.3.4",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "4.23.13",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}

 const config=parseMediaServiceQualification(await immutableJson(cli.path,cli.sha256)),now=Date.now();if(Date.parse(config.expiresAt)<=now+360000||Date.parse(config.expiresAt)>now+3600000)throw Error('QUALIFICATION_CONFIGURATION_INVALID');
 const bundle=await immutableJson(config.bundleManifestPath,config.bundleManifestSha256);if(bundle.sourceCommit!==config.sourceCommit||bundle.service!=='media-qualification'||bundle.deployable!==true||bundle.inputs?.find((entry:{path:string})=>entry.path==='src/lib/higgsfield-vercel-media-sandbox.ts')?.sha256!==BACKEND_SHA256)throw Error('QUALIFICATION_SOURCE_CHANGED');
 const entry=fileURLToPath(import.meta.url);if(bundle.runtime?.path!=='runtime.mjs'||entry!==dirname(config.bundleManifestPath)+'/runtime.mjs'||!Number.isSafeInteger(bundle.runtime.bytes)||bundle.runtime.bytes<1||bundle.runtime.bytes>8*1024**2||(await lstat(entry)).size!==bundle.runtime.bytes||hash(await readFile(entry))!==bundle.runtime.sha256)throw Error('QUALIFICATION_SOURCE_CHANGED');
 await assertRemoteArchiveImmutableFile(config.input.path);if((await lstat(config.input.path)).size!==config.input.bytes)throw Error('QUALIFICATION_INPUT_CHANGED');const input=await readFile(config.input.path);if(input.length!==config.input.bytes||hash(input)!==config.input.sha256)throw Error('QUALIFICATION_INPUT_CHANGED');
 const directory=await lstat(config.outputDirectory);if(!directory.isDirectory()||directory.isSymbolicLink()||directory.uid!==process.getuid?.()||(directory.mode&0o077)||await realpath(config.outputDirectory)!==config.outputDirectory)throw Error('QUALIFICATION_OUTPUT_INVALID');
 const audit=await open(config.outputDirectory+'/journal.jsonl','wx',0o600),control=new AbortController(),stop=()=>control.abort(),timer=setTimeout(stop,Math.min(420000,Date.parse(config.expiresAt)-Date.now()));process.once('SIGTERM',stop);process.once('SIGINT',stop);
 const append=async(value:unknown)=>{const text=JSON.stringify({at:new Date().toISOString(),...value as object});await audit.write(text+'\n');await audit.sync();console.log(text);};
 const session=mediaQualificationJournal(config,append,control.signal);let completed=false,failureCode:string|null=null,observed:unknown=null;
 try{await append({type:'qualification-start',productionAccepted:false,reservation:config.reservation,backendSha256:BACKEND_SHA256,input:{bytes:input.length,sha256:hash(input)}});
  const sandbox=await createVercelMediaSandbox({teamId:config.teamId,projectId:config.projectId,region:config.region,limits:config.limits,closure:config.closure,journal:session.journal,token:async()=>{const value=process.env.COATRIA_VERCEL_MEDIA_TOKEN;if(!value||value.length<8||value.length>4096||/[\r\n]/.test(value))throw Error('QUALIFICATION_CREDENTIAL_UNAVAILABLE');return value;}},config.qualification);
  const descriptor=await inspectHiggsfieldArchiveMedia({path:config.input.path,expectedKind:'image',expectedBytes:config.input.bytes,expectedSha256:config.input.sha256,signal:control.signal},{sandbox,sandboxTimeoutMs:90000,limits:{timeoutMs:300000,maxBytes:config.limits.maxInputBytes,maxProbeBytes:config.limits.maxOutputBytes}});observed=descriptor;const dimension=config.input.bytes===111?16:2048;if(descriptor.kind!=='image'||descriptor.format!=='png'||descriptor.codec!=='png'||descriptor.width!==dimension||descriptor.height!==dimension||descriptor.verification!=='full_decode'||descriptor.bytes!==config.input.bytes||descriptor.sha256!==config.input.sha256)throw Error('QUALIFICATION_MEDIA_MISMATCH');
  const state=session.snapshot();if(state.createsReserved!==3||state.unresolvedIntent!==null||state.terminalSessions.length!==3)throw Error('QUALIFICATION_CLEANUP_UNCONFIRMED');completed=true;
 }catch(error){failureCode=typeof(error as {code?:unknown})?.code==='string'?(error as {code:string}).code:error instanceof Error&&/^QUALIFICATION_[A-Z_]+$/.test(error.message)?error.message:'QUALIFICATION_FAILED';await append({type:'qualification-failed',code:failureCode});}
 finally{clearTimeout(timer);process.removeListener('SIGTERM',stop);process.removeListener('SIGINT',stop);await audit.sync();await audit.close();}
 const report={version:1,purpose:'qualification-only',productionAccepted:false,completed,failureCode,sourceCommit:config.sourceCommit,backendSha256:BACKEND_SHA256,reservation:config.reservation,limits:config.limits,input:{bytes:config.input.bytes,sha256:config.input.sha256},observed,...session.snapshot()};const file=await open(config.outputDirectory+'/report.json','wx',0o600);try{await file.writeFile(JSON.stringify(report,null,2)+'\n');await file.sync();}finally{await file.close();}console.log(JSON.stringify({type:'qualification-result',...report}));return report;
}
if(process.argv[1]&&import.meta.url===pathToFileURL(resolve(process.argv[1])).href){void runMediaServiceQualification(process.argv.slice(2)).then(report=>{if(!report.completed)process.exitCode=1;}).catch(()=>{console.error('QUALIFICATION_CONFIGURATION_INVALID');process.exitCode=1;});}

export function parseMediaServiceQualification(value:unknown){
 const config=schema.parse(value),ordinals=config.reservation.ordinals;
 if(ordinals[1]!==ordinals[0]+1||ordinals[2]!==ordinals[1]+1||config.outputDirectory!=='/var/lib/coatria-media-qualification/'+config.reservation.id)throw Error('QUALIFICATION_CONFIGURATION_INVALID');
 const small=config.input.bytes===111&&config.input.sha256==='b6203732a9ba997cc892a1b15d1d8bc92eb4abea11166d09734e4e2deffa0c8f',large=config.input.bytes===12586943&&config.input.sha256==='49c5ff2929aecbf4d576b1986c1060605a6edb007fc08239c6e1cf7cdf34ab5a';
 if(!small&&!large||config.input.bytes>config.limits.maxInputBytes)throw Error('QUALIFICATION_CONFIGURATION_INVALID');const freeze=(value:any)=>{if(value&&typeof value==='object'){for(const item of Object.values(value))freeze(item);Object.freeze(value);}};freeze(config);return config;
